# Absolute public origin; set before building in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until the company profile, legal copy and delivery are verified.
NEXT_PUBLIC_LAUNCH_READY=false
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
# Optional verified contact links. Use international format for the phone.
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=
# Reserved for YOUR server-side implementation; not read by the demo route.
# Never prefix credentials with NEXT_PUBLIC_.
INQUIRY_EMAIL_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_TO_EMAIL=
INQUIRY_STORAGE_BUCKET=
RATE_LIMIT_STORE_URL=
RATE_LIMIT_STORE_TOKEN=
